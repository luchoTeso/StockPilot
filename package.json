{
  "name": "inventario-node",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "npx nodemon app.js",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm install --include=dev && npm run build",
    "migrate": "node scripts/migrate.js",
    "seed": "node database/seed_test_data.js",
    "test": "vitest run",
    "test:evidence": "vitest run --reporter=verbose --reporter=json --outputFile=evidencia_pruebas.json && node generar_reporte.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dashboard": "vitest --ui",
    "test:ui": "npx playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "openai": "^4.20.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "vitest": "^4.1.4"
  },
  "description": "",
  "type": "commonjs"
}
