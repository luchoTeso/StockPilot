# ─────────────────────────────────────────────────
# StockPilot — Variables de Entorno
# ─────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# Secreto para firmar las sesiones de Express (puede ser cualquier texto largo)
SESSION_SECRET=tu_secreto_aqui

# Puerto donde corre el servidor backend
PORT=3000

# Tu API Key de OpenAI (obtener en https://platform.openai.com)
# Necesaria para el módulo de Inteligencia Artificial de Reabastecimiento
OPENAI_API_KEY=sk-tu_api_key_aqui

# Configuración de Correo SMTP (para alertas semanales y recuperación de contraseña)
# Puedes usar una cuenta de Gmail con "Contraseña de aplicación"
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
