# ─────────────────────────────────────────────────
# StockPilot — Variables de Entorno
# ─────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# Entorno de ejecución: "development" o "production"
NODE_ENV=development

# Puerto donde corre el servidor backend
PORT=3001

# ── Base de datos ──────────────────────────────────
# Cadena de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# Ejemplo local:      postgresql://postgres:1234@localhost:5432/stockpilot
# Ejemplo Railway:    postgresql://postgres:xxxx@monorail.proxy.rlwy.net:PORT/railway
DATABASE_URL=postgresql://postgres:contraseña@localhost:5432/stockpilot

# ── Sesiones ──────────────────────────────────────
# Cadena aleatoria larga para firmar las cookies de sesión.
# Genera una en la terminal con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  OBLIGATORIO en producción — el servidor no arrancará sin este valor.
SESSION_SECRET=

# ── URLs ──────────────────────────────────────────
# URL pública de la aplicación (usada en los emails de alertas y recuperación de contraseña)
# Desarrollo: http://localhost:5173
# Producción: https://tu-dominio.com
APP_URL=http://localhost:5173

# URL(s) del frontend permitidas por CORS (separadas por coma si son varias)
# Desarrollo: http://localhost:5173
# Producción: https://tu-dominio.com
CORS_ORIGIN=http://localhost:5173

# ── OpenAI ────────────────────────────────────────
# API Key para el módulo de Inteligencia Artificial de Reabastecimiento
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu_api_key_aqui

# ── Correo SMTP ───────────────────────────────────
# Para alertas semanales, órdenes de compra y recuperación de contraseña.
# Recomendado: cuenta Gmail con "Contraseña de aplicación" (no tu contraseña normal).
# Guía: https://support.google.com/accounts/answer/185833
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
